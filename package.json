{
  "name": "gas-project-template",
  "version": "1.0.0",
  "description": "Google Apps Script プロジェクトテンプレート（TypeScript + clasp + Jest）",
  "scripts": {
    "build": "node esbuild.config.js",
    "push": "npm run build && clasp push",
    "deploy": "npm run push && clasp create-deployment",
    "watch": "node esbuild.config.js --watch",
    "open": "clasp open-script",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src __tests__ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "docker:build": "docker-compose build",
    "docker:test": "docker-compose run --rm gas-test",
    "docker:dev": "docker-compose up gas-dev",
    "docker:shell": "docker-compose run --rm gas-shell"
  },
  "keywords": [
    "google-apps-script",
    "gas",
    "clasp",
    "typescript",
    "jest",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "esbuild": "^0.28.1",
    "esbuild-gas-plugin": "^0.10.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
