# Script Properties のキーテンプレート
# このファイルは登録が必要なキーの一覧です。
# 実際の値は GAS エディタの「プロジェクトの設定」→「スクリプト プロパティ」に登録してください。
# .env ファイルとしてローカルで使用するものではありません。

# DB 接続を使うプロジェクトのキー例（不要なら削除）
# CONNECTION_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# ログレベル制御（debug / info / warn / error）
# LOG_LEVEL=info

# ログ書き込み先シート名（省略時はスプレッドシート出力なし）
# LOG_SHEET_NAME=

# 環境識別
# APP_ENV=development
